{
  "id": "gabriel-portal-01",
  "title": "Gabriel e o Portal Misterioso",
  "subtitle": "Uma aventura de amizade e coragem",
  "description": "Gabriel, Luna, Theo e Floquinho descobrem um portal que leva a um mundo de blocos.",
  "category": "Aventura • 6 anos",
  "cover": "",
  "pages": [
    {
      "id": "p01",
      "type": "cover",
      "title": "Gabriel e o Portal Misterioso",
      "text": "Uma aventura de amizade e coragem. Preparado para entrar no portal?",
      "scene": "portal"
    },
    {
      "id": "p02",
      "type": "story",
      "title": "Conheça a turma",
      "text": "Gabriel é curioso e corajoso.\nLuna tem ideias criativas.\nTheo adora construir.\nFloquinho é um lobo muito fiel!",
      "scene": "equipe"
    },
    {
      "id": "p03",
      "type": "story",
      "title": "Um dia de aventura",
      "text": "Gabriel chamou Luna e Theo para brincar.\nFloquinho foi junto.\nTodos correram para a floresta.",
      "scene": "floresta"
    },
    {
      "id": "p04",
      "type": "story",
      "title": "Uma luz roxa",
      "text": "De repente, Gabriel viu uma luz.\nEla vinha de um portal roxo!\n— Que lugar será esse?",
      "scene": "portal"
    },
    {
      "id": "p05",
      "type": "story",
      "title": "Três, dois, um!",
      "text": "Os amigos deram as mãos.\nGabriel contou até três.\nE todos entraram no portal!",
      "scene": "portal"
    },
    {
      "id": "p06",
      "type": "story",
      "title": "Tudo era diferente",
      "text": "Do outro lado, havia ilhas no céu, árvores roxas e rios brilhantes.\nEra um mundo feito de blocos!",
      "scene": "ilha"
    },
    {
      "id": "p07",
      "type": "story",
      "title": "Uma trilha secreta",
      "text": "Floquinho farejou o chão.\nEle achou uma trilha de luz.\nOs três amigos foram atrás dele.",
      "scene": "floresta"
    },
    {
      "id": "p08",
      "type": "story",
      "title": "O castelo escuro",
      "text": "A trilha levava a um castelo.\nLá, sombras de pedra se mexiam.\nOs amigos ficaram bem juntinhos.",
      "scene": "castelo"
    },
    {
      "id": "p09",
      "type": "story",
      "title": "Um plano de equipe",
      "text": "— Tenho uma ideia! — disse Gabriel.\nTheo construiu um muro.\nLuna abriu um caminho de blocos.",
      "scene": "equipe"
    },
    {
      "id": "p10",
      "type": "story",
      "title": "O Coração do Mundo",
      "text": "No castelo, havia um grande cristal.\nEle estava perdendo a sua luz.\nO mundo precisava de ajuda!",
      "scene": "cristal"
    },
    {
      "id": "p11",
      "type": "story",
      "title": "O Guardião apareceu",
      "text": "BUM! Surgiu um gigante de sombra.\nEle queria guardar toda a luz.\nMas Gabriel não deixou os amigos sós.",
      "scene": "castelo"
    },
    {
      "id": "p12",
      "type": "story",
      "title": "A grande missão",
      "text": "O Guardião lançou sombras no chão.\nGabriel protegeu os amigos.\nLuna e Theo correram até o cristal.",
      "scene": "equipe"
    },
    {
      "id": "p13",
      "type": "story",
      "title": "A luz voltou!",
      "text": "Floquinho achou uma pedra de luz.\nOs amigos a levaram ao cristal.\nPLIM! Todo o castelo brilhou!",
      "scene": "cristal"
    },
    {
      "id": "p14",
      "type": "story",
      "title": "O portal se abriu",
      "text": "As sombras foram embora.\nO portal voltou a aparecer.\nEra hora de voltar para casa.",
      "scene": "portal"
    },
    {
      "id": "p15",
      "type": "story",
      "title": "De volta ao lar",
      "text": "Os amigos saíram do portal.\nA floresta estava em paz.\nGabriel abraçou Floquinho.",
      "scene": "floresta"
    },
    {
      "id": "p16",
      "type": "story",
      "title": "O maior tesouro",
      "text": "Gabriel olhou para seus amigos.\nEle tinha aprendido uma lição:\njuntos, somos mais fortes!",
      "scene": "sol"
    },
    {
      "id": "p17",
      "type": "moral",
      "title": "O que aprendemos?",
      "text": "CORAGEM é tentar, mesmo com medo.\nAMIZADE é cuidar dos amigos.\nEQUIPE é ajudar e aceitar ajuda.",
      "scene": "equipe"
    },
    {
      "id": "p18",
      "type": "quiz",
      "title": "Missão especial!",
      "text": "Responda às perguntas e conquiste sua estrela.",
      "scene": "quiz",
      "questions": [
        {
          "question": "De que cor era o portal?",
          "options": [
            "Roxo",
            "Verde",
            "Azul"
          ],
          "correct": 0
        },
        {
          "question": "Quem era o lobo da turma?",
          "options": [
            "Theo",
            "Floquinho",
            "Gabriel"
          ],
          "correct": 1
        },
        {
          "question": "O que ajudou os amigos?",
          "options": [
            "Brigar",
            "Trabalhar juntos",
            "Desistir"
          ],
          "correct": 1
        }
      ]
    },
    {
      "id": "p19",
      "type": "end",
      "title": "Fim... por enquanto!",
      "text": "Qual será a próxima aventura?\nContinue imaginando. Continue lendo!",
      "scene": "sol"
    }
  ]
}
